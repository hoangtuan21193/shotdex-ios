{
  "steps": [
    { "action": "launch", "arguments": ["-ShotDexFakeICloud", "cloud=all,seconds=10,fail=3,mb=24"] },
    { "action": "wait", "seconds": 6 },
    { "action": "tap", "label": "Select photos", "type": "button" },
    { "action": "wait", "seconds": 1 },
    { "action": "tap", "x": 0.165, "y": 0.30 },
    { "action": "tap", "x": 0.83, "y": 0.30 },
    { "action": "tap", "x": 0.165, "y": 0.46 },
    { "action": "tap", "label": "More selection actions" },
    { "action": "wait", "seconds": 1 },
    { "action": "tap", "label": "Resize" },
    { "action": "wait", "seconds": 4 },
    { "action": "screenshot", "name": "01-resize-form" },
    { "action": "tap", "label": "Resize 3 Photos", "type": "button" },
    { "action": "wait", "seconds": 2 },
    { "action": "screenshot", "name": "02-downloading-line" },
    { "action": "wait", "seconds": 3 },
    { "action": "screenshot", "name": "03-downloading-later" },
    { "action": "wait", "seconds": 7 },
    { "action": "screenshot", "name": "04-failure" },
    { "action": "dump", "name": "04-failure" },
    { "action": "tap", "label": "Cancel", "type": "button", "index": 1 },
    { "action": "wait", "seconds": 1.5 },
    { "action": "screenshot", "name": "05-back-to-form" },
    { "action": "dump", "name": "05-back-to-form" }
  ]
}
