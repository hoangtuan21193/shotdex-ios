{
  "steps": [
    { "action": "launch", "arguments": ["-ShotDexFakeICloud", "cloud=all,seconds=5,mb=24"] },
    { "action": "wait", "seconds": 6 },
    { "action": "tap", "x": 0.165, "y": 0.30 },
    { "action": "wait", "seconds": 1.5 },
    { "action": "screenshot", "name": "01-viewer-glyph" },
    { "action": "tap", "label": "Share", "type": "button" },
    { "action": "wait", "seconds": 2.5 },
    { "action": "screenshot", "name": "02-sheet-open" },
    { "action": "tap", "label": "View More" },
    { "action": "wait", "seconds": 1.5 },
    { "action": "tap", "label": "Save to Files" },
    { "action": "wait", "seconds": 2 },
    { "action": "screenshot", "name": "03-modal" },
    { "action": "wait", "seconds": 7 },
    { "action": "screenshot", "name": "04-files-picker" },
    { "action": "tap", "label": "Save", "type": "button" },
    { "action": "wait", "seconds": 2 },
    { "action": "tap", "label": "Keep Both", "type": "button" },
    { "action": "wait", "seconds": 3 },
    { "action": "screenshot", "name": "05-saved" },
    { "action": "dump", "name": "05-saved" }
  ]
}
