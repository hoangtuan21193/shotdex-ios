{
  "steps": [
    {
      "action": "launch",
      "arguments": [
        "-ShotDexFakeICloud",
        "cloud=all,seconds=120,mb=24"
      ]
    },
    {
      "action": "wait",
      "seconds": 6
    },
    {
      "action": "longPress",
      "label": "Photo, file type HEIC",
      "type": "cell",
      "seconds": 1.2
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "screenshot",
      "name": "01-tile-menu"
    },
    {
      "action": "tap",
      "label": "Share",
      "type": "button"
    },
    {
      "action": "wait",
      "seconds": 2.5
    },
    {
      "action": "screenshot",
      "name": "02-sheet-open"
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "tap",
      "label": "Save to Files",
      "type": "cell"
    },
    {
      "action": "wait",
      "seconds": 2.5
    },
    {
      "action": "screenshot",
      "name": "03-modal"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "screenshot",
      "name": "04-modal-later"
    },
    {
      "action": "tap",
      "label": "Cancel",
      "type": "button"
    },
    {
      "action": "wait",
      "seconds": 2.5
    },
    {
      "action": "screenshot",
      "name": "05-library-after"
    },
    {
      "action": "dump",
      "name": "05-library-after"
    }
  ]
}