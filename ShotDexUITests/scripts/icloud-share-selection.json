{
  "steps": [
    { "action": "launch", "arguments": ["-ShotDexFakeICloud", "cloud=3,seconds=6,mb=20"] },
    { "action": "wait", "seconds": 6 },
    { "action": "tap", "label": "Select photos", "type": "button" },
    { "action": "wait", "seconds": 1 },
    { "action": "tap", "x": 0.165, "y": 0.30 },
    { "action": "tap", "x": 0.83, "y": 0.30 },
    { "action": "tap", "x": 0.165, "y": 0.46 },
    { "action": "tap", "x": 0.5, "y": 0.46 },
    { "action": "tap", "x": 0.83, "y": 0.46 },
    { "action": "wait", "seconds": 1 },
    { "action": "screenshot", "name": "01-selected" },
    { "action": "tap", "label": "Share", "type": "button" },
    { "action": "wait", "seconds": 2 },
    { "action": "screenshot", "name": "02-sheet-open-nothing-downloaded" },
    { "action": "dump", "name": "02-sheet-open-nothing-downloaded" },
    { "action": "tap", "label": "View More" },
    { "action": "wait", "seconds": 1.5 },
    { "action": "screenshot", "name": "02b-more" },
    { "action": "tap", "label": "Save to Files" },
    { "action": "wait", "seconds": 1.5 },
    { "action": "screenshot", "name": "03-modal" },
    { "action": "dump", "name": "03-modal" },
    { "action": "wait", "seconds": 3 },
    { "action": "screenshot", "name": "04-modal-later" },
    { "action": "wait", "seconds": 6 },
    { "action": "screenshot", "name": "05-files-picker" },
    { "action": "tap", "label": "Save", "type": "button" },
    { "action": "wait", "seconds": 4 },
    { "action": "screenshot", "name": "06-saved" },
    { "action": "dump", "name": "06-saved" }
  ]
}
