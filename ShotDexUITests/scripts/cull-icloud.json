{
  "steps": [
    {
      "action": "launch",
      "arguments": [
        "-ShotDexFakeICloud",
        "cloud=all,stall"
      ]
    },
    {
      "action": "wait",
      "seconds": 6
    },
    {
      "action": "tap",
      "label": "Select photos"
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "tap",
      "x": 0.165,
      "y": 0.3
    },
    {
      "action": "tap",
      "x": 0.5,
      "y": 0.3
    },
    {
      "action": "tap",
      "x": 0.835,
      "y": 0.3
    },
    {
      "action": "tap",
      "x": 0.165,
      "y": 0.45
    },
    {
      "action": "tap",
      "x": 0.5,
      "y": 0.45
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "tap",
      "label": "More selection actions"
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "tap",
      "label": "Cull 5 Photos"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "screenshot",
      "name": "02-cull-icloud"
    },
    {
      "action": "dump",
      "name": "02-cull-icloud"
    },
    {
      "action": "key",
      "text": "x"
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "key",
      "text": "z",
      "direction": "cmd"
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "tap",
      "label": "Close"
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "tap",
      "label": "Done selecting"
    },
    {
      "action": "wait",
      "seconds": 1
    }
  ]
}
