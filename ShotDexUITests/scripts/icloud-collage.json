{
  "steps": [
    { "action": "launch", "arguments": ["-ShotDexFakeICloud", "cloud=all,seconds=3,fail=2,mb=24"] },
    { "action": "wait", "seconds": 6 },
    { "action": "tap", "label": "Select photos", "type": "button" },
    { "action": "wait", "seconds": 1 },
    { "action": "tap", "x": 0.165, "y": 0.30 },
    { "action": "tap", "x": 0.83, "y": 0.30 },
    { "action": "tap", "x": 0.165, "y": 0.46 },
    { "action": "tap", "x": 0.5, "y": 0.46 },
    { "action": "tap", "label": "More selection actions" },
    { "action": "wait", "seconds": 1 },
    { "action": "tap", "label": "Create Collage" },
    { "action": "wait", "seconds": 5 },
    { "action": "screenshot", "name": "01-collage" },
    { "action": "tap", "label": "Export", "type": "button" },
    { "action": "wait", "seconds": 3 },
    { "action": "screenshot", "name": "02-export-screen" },
    { "action": "tap", "label": "Save to Photos", "type": "button" },
    { "action": "wait", "seconds": 2 },
    { "action": "screenshot", "name": "03-downloading" },
    { "action": "wait", "seconds": 12 },
    { "action": "screenshot", "name": "04-failure" },
    { "action": "dump", "name": "04-failure" }
  ]
}
