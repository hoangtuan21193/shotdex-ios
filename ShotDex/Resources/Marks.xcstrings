      "extractionState": "manual"
    },
    "Reject": {
      "comment": "Flag menu: drop this photo",
      "extractionState": "manual"
    },
    "Rejected": {
      "comment": "A photo's flag: dropped in a culling pass",
      "extractionState": "manual"
    },
    "Remove flag filter %@": {
      "comment": "VoiceOver: remove a Picks/Rejected/Unflagged chip",
      "extractionState": "manual"
    },
