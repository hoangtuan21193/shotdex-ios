                }
              }
            }
          }
        }
      }
    },
    "None": {
      "comment": "Rating menu: clear the stars",
      "extractionState": "manual"
    },
    "Pick": {
      "comment": "Flag menu: keep this photo",
      "extractionState": "manual"
    },
    "Picked": {
      "comment": "A photo's flag: kept in a culling pass",
      "extractionState": "manual"
    },
    "Picks": {
      "comment": "Filter menu row and chip: only Picked photos",
      "extractionState": "manual"
    },
