    "Couldn't save your video draft": {
      "comment": "Video Studio: banner and alert when the draft could not be written (disk full, database error)",
      "extractionState": "manual"
    },
    "Delete Draft": {
      "comment": "Video Projects: menu action that deletes a video draft — never the photos or videos it uses",
      "extractionState": "manual"
    },
    "Delete Draft?": {
      "comment": "Video Projects: title of the confirmation before a draft is deleted",
      "extractionState": "manual"
    },
    "Draft": {
      "comment": "Video Projects: label on a video project that has never been exported",
      "extractionState": "manual"
    },
    "Edited %@": {
      "comment": "Video Projects: when a draft was last changed; the argument is a relative time such as '5 min. ago'",
      "extractionState": "manual"
    },
    "Leave Without Saving": {
      "comment": "Video Studio: closes the studio although the latest draft could not be written",
      "extractionState": "manual"
    },
    "Look": {
      "comment": "Video Studio: the bottom-row tool that changes the whole video's look — filter, adjustments, colour",
      "extractionState": "manual"
    },
    "Media": {
      "comment": "Video Studio: the bottom-row tool that adds photos and videos to the timeline",
      "extractionState": "manual"
    },
    "Mute Video Sound": {
      "comment": "Video Studio level meter: silences the clips' own audio for the whole project",
      "extractionState": "manual"
    },
    "Playhead at %@ of %@": {
      "comment": "Video Studio transport: VoiceOver label for the phone read-out — playhead, then the project's length",
      "extractionState": "manual"
    },
    "The photos and videos stay in your library.": {
      "comment": "Video Projects: message of the Delete Draft confirmation — deleting a draft never touches the library",
      "extractionState": "manual"
    },
    "Try Again": {
      "comment": "Video Studio: retries writing the video draft",
      "extractionState": "manual"
    },
    "Unmute Video Sound": {
      "comment": "Video Studio level meter: restores the clips' own audio for the whole project",
      "extractionState": "manual"
    },
    "Video Project, Draft, %@, %@": {
      "comment": "VoiceOver: a draft row in Video Projects — date, then the subtitle",
      "extractionState": "manual"
    },
    "Video Settings": {
      "comment": "Video Studio: the panel for the project's ratio, background, resolution and frame rate",
      "extractionState": "manual"
    },
    "Video sound": {
      "comment": "Video Studio: the clips' own audio level for the whole project",
      "extractionState": "manual"
    }
  },
  "version": "1.0"
