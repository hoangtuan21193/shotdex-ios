{
  "sourceLanguage": "en",
  "strings": {
    " · %lld clips not checked": {
      "comment": "Video Studio ducking: after the summary — clips whose sound could not be read (in iCloud with no network), so they lower nothing (plural)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
