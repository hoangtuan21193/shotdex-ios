{
  "sourceLanguage": "en",
  "strings": {
    "%@ is missing. Import it again, then pick it in LUTs.": {
      "comment": "Video Studio Look panel: the chosen look's LUT file was deleted — e.g. Kodak 2383 is missing",
      "extractionState": "manual"
    },
    "%@ · %@": {
      "comment": "Video Projects: a draft's subtitle — when it was edited, then how many clips",
      "extractionState": "manual"
    },
    "%@, unavailable": {
      "comment": "Video Studio Video Settings: VoiceOver name of a dimmed choice, e.g. 4K, unavailable",
      "extractionState": "manual"
    },
    "%lld clips": {
      "comment": "Video Projects: how many clips a video project has (plural)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clip"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clips"
                }
              }
            }
          }
        }
      }
    },
    "%lld clips are waiting for iCloud": {
      "comment": "Video Studio banner: clips whose originals have not downloaded yet stay in place as gaps (plural)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clip is waiting for iCloud"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clips are waiting for iCloud"
                }
              }
            }
          }
        }
      }
    },
    "%lld fps": {
      "comment": "Video Studio settings button: the project's frame rate, e.g. 30 fps",
      "extractionState": "manual"
    },
    "%lld items in this video": {
      "comment": "Video Studio Media panel: under its name on the In Video tab — how many uses of library items the video has",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item in this video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items in this video"
                }
              }
            }
          }
        }
      }
    },
    "%lld looks are missing their LUT and export without it.": {
      "comment": "Video Studio Export and Video Settings: how many looks (the video's and clips' own) lost their LUT file; the export goes on without it",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld look is missing its LUT and exports without it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld looks are missing their LUT and export without it."
                }
              }
            }
          }
        }
      }
    },
    "%lld selected · Add puts them at %@": {
      "comment": "Video Studio Media panel: under its name while selecting — how many are picked and the playhead time Add inserts them at",
      "extractionState": "manual"
    },
    "4K needs 4K clips — %lld of your %lld clips are %@.": {
      "comment": "Video Studio Video Settings: why 4K is dimmed — how many clips fall short, and the resolution they all are",
      "extractionState": "manual"
    },
    "4K needs 4K clips — %lld of your %lld clips are smaller than 4K.": {
      "comment": "Video Studio Video Settings: why 4K is dimmed — how many clips fall short, at mixed resolutions",
      "extractionState": "manual"
    },
    "4K needs 4K clips — 1 of your %lld clips is %@.": {
      "comment": "Video Studio Video Settings: why 4K is dimmed — one clip falls short, and its resolution",
      "extractionState": "manual"
    },
    "4K needs 4K clips — 1 of your %lld clips is smaller than 4K.": {
      "comment": "Video Studio Video Settings: why 4K is dimmed — one clip falls short",
      "extractionState": "manual"
    },
    "APPLY TO": {
      "comment": "Video Studio Look panel: header over All Clips · This Clip — where a tapped look goes",
      "extractionState": "manual"
    },
    "Add (%lld)": {
      "comment": "Video Studio Media panel: adds the picked items at the playhead, with how many",
      "extractionState": "manual"
    },
    "Add Music": {
      "comment": "Video Studio: title of the Music tool's panel",
      "extractionState": "manual"
    },
    "Albums": {
      "comment": "Video Studio Media panel tab: the user's albums; also the back button from an album's grid",
      "extractionState": "manual"
    },
    "All Clips": {
      "comment": "Video Studio Look panel: a tapped look becomes the whole video's and clears every clip's own",
      "extractionState": "manual"
    },
    "Allow access to your photo library in Settings to add photos and videos here.": {
      "comment": "Video Studio Media panel: body when Photos access is denied",
      "extractionState": "manual"
    },
    "Amount": {
      "comment": "Video Studio Look panel: how much of the chosen look is mixed in, 0–100",
      "extractionState": "manual"
    },
    "Apply to": {
      "comment": "Video Studio clip Look block: label before This Clip · Selected · All Clips",
      "extractionState": "manual"
    },
    "BACKGROUND": {
      "comment": "Video Studio Video Settings: section header over what shows around a fitted clip",
      "extractionState": "manual"
    },
    "Beats": {
      "comment": "Video Studio: the music command that marks a song's beats",
      "extractionState": "manual"
    },
    "Black": {
      "comment": "Video Studio Video Settings: the black background swatch",
      "extractionState": "manual"
    },
    "Blur": {
      "comment": "Video Studio Video Settings: the background is the clip itself, blurred; also the slider's name",
      "extractionState": "manual"
    },
    "CODEC": {
      "comment": "Video Studio Video Settings: section header over H.264 / HEVC",
      "extractionState": "manual"
    },
    "Camera, lens, 85mm, ISO 3200…": {
      "comment": "Video Studio Media panel: placeholder of the search field — the Library's query language",
      "extractionState": "manual"
    },
    "Cancel": {
      "comment": "Video Studio: leaves search",
      "extractionState": "manual"
    },
    "Cancel Export": {
      "comment": "Video Studio Export: stops the export in progress",
      "extractionState": "manual"
    },
    "Changes apply right away — Export uses them.": {
      "comment": "Video Studio Video Settings: under the Output row",
      "extractionState": "manual"
    },
    "Choose where it goes next": {
      "comment": "Video Studio Export, server photos: the file goes to the export sheet after rendering",
      "extractionState": "manual"
    },
    "Choose…": {
      "comment": "Video Studio Video Settings: picks the library photo behind fitted clips",
      "extractionState": "manual"
    },
    "Clarity": {
      "comment": "Video Studio Look panel: a photo setting skipped on video",
      "extractionState": "manual"
    },
    "Close": {
      "comment": "Video Studio: closes a panel",
      "extractionState": "manual"
    },
    "Color": {
      "comment": "Video Studio Video Settings: the background is one color",
      "extractionState": "manual"
    },
    "Couldn't save your video draft": {
      "comment": "Video Studio: banner and alert when the draft could not be written (disk full, database error)",
      "extractionState": "manual"
    },
    "Custom": {
      "comment": "Video Studio Export: the row that exports at the project's own Video Settings; a tap opens them",
      "extractionState": "manual"
    },
    "Custom Color": {
      "comment": "Video Studio Video Settings: picks a background color of one's own",
      "extractionState": "manual"
    },
    "Dehaze": {
      "comment": "Video Studio Look panel: a photo setting skipped on video",
      "extractionState": "manual"
    },
    "Delete Draft": {
      "comment": "Video Projects: menu action that deletes a video draft — never the photos or videos it uses",
      "extractionState": "manual"
    },
    "Delete Draft?": {
      "comment": "Video Projects: title of the confirmation before a draft is deleted",
      "extractionState": "manual"
    },
    "Discard Changes": {
      "comment": "Video Studio: the ✕ that closes a tool panel and throws away what it changed",
      "extractionState": "manual"
    },
    "Done": {
      "comment": "Video Studio Video Settings: closes the panel; every change is already applied",
      "extractionState": "manual"
    },
    "Draft": {
      "comment": "Video Projects: label on a video project that has never been exported",
      "extractionState": "manual"
    },
    "Drop between clips · back on the grid cancels": {
      "comment": "Video Studio Media panel: under its name while an item is being dragged",
      "extractionState": "manual"
    },
    "Ducking": {
      "comment": "Video Studio: the music command that lowers music under speech",
      "extractionState": "manual"
    },
    "Duplicate": {
      "comment": "Video Studio: the command that copies the selected item right after it",
      "extractionState": "manual"
    },
    "Edited %@": {
      "comment": "Video Projects: when a draft was last changed; the argument is a relative time such as '5 min. ago'",
      "extractionState": "manual"
    },
    "End to Playhead": {
      "comment": "Video Studio Trim: cuts the selected clip's end to the playhead",
      "extractionState": "manual"
    },
    "Everything in this look applies to video.": {
      "comment": "Video Studio Look panel: nothing in the chosen look is skipped on video",
      "extractionState": "manual"
    },
    "Export": {
      "comment": "Video Studio Export: starts the export",
      "extractionState": "manual"
    },
    "Export Video": {
      "comment": "Video Studio: title of the export panel",
      "extractionState": "manual"
    },
    "Export stopped when you left ShotDex. Export again to finish.": {
      "comment": "Video Studio Export: the export was cancelled because the app went to the background",
      "extractionState": "manual"
    },
    "Exporting, %lld percent": {
      "comment": "Video Studio Export: VoiceOver reading of the progress bar",
      "extractionState": "manual"
    },
    "Exporting… %lld%%": {
      "comment": "Video Studio Export: progress while the video is rendered",
      "extractionState": "manual"
    },
    "Export…": {
      "comment": "Video Studio Export, server photos: renders, then asks where the file goes",
      "extractionState": "manual"
    },
    "FONTS YOU USED": {
      "comment": "Video Studio media pool Text tab: header over the fonts the user has used before",
      "extractionState": "manual"
    },
    "FRAME RATE": {
      "comment": "Video Studio Video Settings: section header over 24 / 30 / 60",
      "extractionState": "manual"
    },
    "Fade": {
      "comment": "Video Studio clip panel: header over the clip's fade in and fade out",
      "extractionState": "manual"
    },
    "Fill": {
      "comment": "Video Studio: the frame label's framing word — clips fill the frame",
      "extractionState": "manual"
    },
    "Fill (Crop)": {
      "comment": "Video Studio Video Settings: the clip fills the frame, cropped from the middle",
      "extractionState": "manual"
    },
    "Fit": {
      "comment": "Video Studio: the frame label's framing word — clips fit on the background",
      "extractionState": "manual"
    },
    "Fit on Background": {
      "comment": "Video Studio Video Settings: the whole clip shows, on the background",
      "extractionState": "manual"
    },
    "Freeze · clip %lld": {
      "comment": "Video Studio In Video row: a held frame and its place on the track",
      "extractionState": "manual"
    },
    "Grey": {
      "comment": "Video Studio Video Settings: the grey background swatch",
      "extractionState": "manual"
    },
    "HEVC is about 40% smaller; some older devices can’t play it.": {
      "comment": "Video Studio Video Settings: under the codec choice",
      "extractionState": "manual"
    },
    "Image": {
      "comment": "Video Studio Video Settings: the background is a library photo",
      "extractionState": "manual"
    },
    "Image unavailable — choose another.": {
      "comment": "Video Studio Video Settings: the background photo was deleted or can no longer be read",
      "extractionState": "manual"
    },
    "Import Look…": {
      "comment": "Video Studio Look panel: brings Lightroom presets, .shotdexlook files and .cube LUTs in from Files",
      "extractionState": "manual"
    },
    "In Video · %lld": {
      "comment": "Video Studio Media panel tab: what of the library is in this video, and how many uses",
      "extractionState": "manual"
    },
    "Insert at Playhead": {
      "comment": "Video Studio Media panel: VoiceOver action — adds the item at the playhead, as a tap does",
      "extractionState": "manual"
    },
    "Keep Changes": {
      "comment": "Video Studio: the ✓ that ends a selection keeping what it changed",
      "extractionState": "manual"
    },
    "Leave Without Saving": {
      "comment": "Video Studio: closes the studio although the latest draft could not be written",
      "extractionState": "manual"
    },
    "Lens Correction": {
      "comment": "Video Studio Look panel: a photo setting skipped on video",
      "extractionState": "manual"
    },
    "Library": {
      "comment": "Video Studio: title of the iPad's media pool column",
      "extractionState": "manual"
    },
    "Limited Photos access": {
      "comment": "Video Studio Media panel: under its name when Photos access is limited",
      "extractionState": "manual"
    },
    "Lock %@": {
      "comment": "Video Studio track switch: stops the named lane (e.g. Video, Music 2) being selected or dragged; the trait says whether it is on",
      "extractionState": "manual"
    },
    "Look": {
      "comment": "Video Studio: the bottom-row tool that changes the whole video's look — filter, adjustments, colour",
      "extractionState": "manual"
    },
    "Look %@": {
      "comment": "Video Studio: VoiceOver — a look by name, after a timeline clip with a look of its own or on a look tile",
      "extractionState": "manual"
    },
    "Look %@, imported from Lightroom": {
      "comment": "Video Studio Look panel: VoiceOver on a look tile brought in from a Lightroom preset",
      "extractionState": "manual"
    },
    "Look for This Clip": {
      "comment": "Video Studio: header of a selected clip's own look block",
      "extractionState": "manual"
    },
    "MY MUSIC": {
      "comment": "Video Studio Music panel: header over the user's imported songs",
      "extractionState": "manual"
    },
    "Manage Access…": {
      "comment": "Video Studio Media panel: opens the system picker to grant more photos under limited access",
      "extractionState": "manual"
    },
    "Media": {
      "comment": "Video Studio: the bottom-row tool that adds photos and videos to the timeline",
      "extractionState": "manual"
    },
    "Missing": {
      "comment": "Video Studio: after the name of a look whose LUT file is gone — Kodak 2383 · Missing",
      "extractionState": "manual"
    },
    "Motion": {
      "comment": "Video Studio clip panel: header over the clip's motion effects — zoom, pan, shake",
      "extractionState": "manual"
    },
    "Move the playhead into this clip.": {
      "comment": "Video Studio Trim: why the Start/End to Playhead chips are dimmed",
      "extractionState": "manual"
    },
    "Music": {
      "comment": "Video Studio: a music bed on the timeline",
      "extractionState": "manual"
    },
    "Mute": {
      "comment": "Video Studio: the speaker at the head of a Volume row — silences the clip or the song, keeping its level",
      "extractionState": "manual"
    },
    "Mute %@": {
      "comment": "Video Studio track switch: silences the named lane (e.g. Video, Music 2); the trait says whether it is on",
      "extractionState": "manual"
    },
    "Mute Video Sound": {
      "comment": "Video Studio level meter: silences the clips' own audio for the whole project",
      "extractionState": "manual"
    },
    "No Access to Photos": {
      "comment": "Video Studio Media panel: title when Photos access is denied",
      "extractionState": "manual"
    },
    "No albums yet.": {
      "comment": "Video Studio Media panel: the Albums tab when the library has no albums of the user's own",
      "extractionState": "manual"
    },
    "No photos or videos yet.": {
      "comment": "Video Studio Media panel: Recents when the library is empty",
      "extractionState": "manual"
    },
    "Noise Reduction": {
      "comment": "Video Studio Look panel: a photo setting skipped on video",
      "extractionState": "manual"
    },
    "Not enough space to export — about %@ needed. Free up space, then try again.": {
      "comment": "Video Studio Export: the device lacks room for the file and its copy in Photos; the size is about twice the estimate",
      "extractionState": "manual"
    },
    "Nothing from your library is in this video yet.": {
      "comment": "Video Studio Media panel: the In Video tab when no clip or sticker comes from the library",
      "extractionState": "manual"
    },
    "Nothing in your library matches.": {
      "comment": "Video Studio Media panel: a search that found nothing",
      "extractionState": "manual"
    },
    "Open Settings": {
      "comment": "Video Studio: opens the app's page in Settings",
      "extractionState": "manual"
    },
    "Or drag the clip's edges on the timeline.": {
      "comment": "Video Studio Trim: the other way to cut a clip",
      "extractionState": "manual"
    },
    "Original clip audio, whole project": {
      "comment": "Video Studio Music panel: caption under the Video sound slider",
      "extractionState": "manual"
    },
    "Output": {
      "comment": "Video Studio Video Settings: the row that states the frame size, length and estimated file size",
      "extractionState": "manual"
    },
    "Photo · clip %lld": {
      "comment": "Video Studio In Video row: a photo clip and its place on the track",
      "extractionState": "manual"
    },
    "Photo · sticker": {
      "comment": "Video Studio In Video row: a library photo laid over the video as a sticker",
      "extractionState": "manual"
    },
    "Photo, %@": {
      "comment": "Video Studio Media panel: VoiceOver label of a photo cell — when it was taken",
      "extractionState": "manual"
    },
    "Playhead at %@ of %@": {
      "comment": "Video Studio transport: VoiceOver label for the phone read-out — playhead, then the project's length",
      "extractionState": "manual"
    },
    "RATIO": {
      "comment": "Video Studio Video Settings: section header over the six frame ratios",
      "extractionState": "manual"
    },
    "RESOLUTION": {
      "comment": "Video Studio Video Settings: section header over 720p / 1080p / 4K",
      "extractionState": "manual"
    },
    "Ratio %@": {
      "comment": "Video Studio Video Settings: VoiceOver name of a ratio button",
      "extractionState": "manual"
    },
    "Recents": {
      "comment": "Video Studio Media panel tab: every photo and video, newest first",
      "extractionState": "manual"
    },
    "Saved to Photos as a new video": {
      "comment": "Video Studio Export: where the exported video goes",
      "extractionState": "manual"
    },
    "Saving to Photos…": {
      "comment": "Video Studio Export: the file is written and is going into the library",
      "extractionState": "manual"
    },
    "Search Library": {
      "comment": "Video Studio Media panel: the search button, by camera, lens, settings or words",
      "extractionState": "manual"
    },
    "Select": {
      "comment": "Video Studio Media panel: starts picking several items to add at once",
      "extractionState": "manual"
    },
    "Selected": {
      "comment": "Video Studio Look panel: a tapped look goes to every selected clip",
      "extractionState": "manual"
    },
    "Sharpening": {
      "comment": "Video Studio Look panel: a photo setting skipped on video",
      "extractionState": "manual"
    },
    "ShotDex can see the %lld items you chose.": {
      "comment": "Video Studio Media panel: with limited Photos access, how many items the user granted",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
