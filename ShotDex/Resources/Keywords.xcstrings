{
  "sourceLanguage": "en",
  "strings": {
    "%@, %lld photos": {
      "comment": "VoiceOver: a keyword suggestion and how many photos carry it",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %#@photos@"
          },
          "substitutions": {
            "photos": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg photo"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg photos"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
