<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Debug entitlements, deliberately without App Attest: it is a paid
	     Apple Developer Program capability, and a personal team cannot sign a
	     build that asks for it. Release signs with ShotDex-AppAttest.entitlements.
	     Without the capability the support portal cannot attest, so the app
	     offers mail instead — see SupportScreen. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hoangtuan.shotdex</string>
	</array>
</dict>
</plist>
