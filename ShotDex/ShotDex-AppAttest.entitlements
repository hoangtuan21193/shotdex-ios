<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's entitlements, Debug and Release. App Attest is a
	     paid-membership capability; the team has had one since 2026-10-22, so
	     Debug signs with it too. The app still falls back to mail when it
	     cannot attest (simulator, a device that refuses).

	     This value applies only to a build installed from Xcode, which attests
	     against Apple's sandbox; iOS ignores it once the app ships, and
	     TestFlight and App Store builds always attest against production. The
	     dev Worker therefore accepts both environments, and the production
	     Worker accepts only production. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hoangtuan.shotdex</string>
	</array>
	<!-- CloudKit private database: index results shared between the
	     devices of one iCloud account (intent 2026-11-02-icloud-shared-index). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.hoangtuan.shotdex</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
