   "type": "staticText"
  },
  {
   "action": "assertExists",
   "label": "Downloading from iCloud Drive…",
   "type": "staticText"
  },
  {
   "action": "assertExists",
   "label": "Read once the file is downloaded",
   "type": "staticText"
  },
  {
   "action": "assertValue",
   "label": "Size",
