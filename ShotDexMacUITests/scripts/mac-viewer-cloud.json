   "type": "button"
  },
  {
   "action": "wait",
   "seconds": 1
  },
  {
   "action": "assertExists",
   "label": "In iCloud Drive · 3 MB",
   "type": "staticText"
  },
  {
   "action": "assertExists",
   "label": "Download",
   "type": "button"
  },
  {
   "action": "assertMissing",
   "label": "Cancel",
   "type": "button"
  },
  {
   "action": "screenshot",
   "name": "02-stopped"
  },
  {
   "action": "key",
   "text": "right"
  },
  {
   "action": "wait",
   "seconds": 1
  },
  {
   "action": "key",
   "text": "left"
  },
  {
   "action": "wait",
   "seconds": 1
  },
  {
   "action": "assertExists",
   "label": "Download",
   "type": "button"
  },
  {
   "action": "click",
   "label": "Download",
   "type": "button"
  },
  {
   "action": "wait",
   "seconds": 1
  },
  {
   "action": "assertExists",
   "label": "Cancel",
   "type": "button"
  },
  {
   "action": "assertExists",
   "label": "Download Progress"
  },
  {
   "action": "wait",
   "seconds": 34
  },
  {
   "action": "assertMissing",
   "label": "Download Progress"
  },
  {
   "action": "assertMissing",
   "label": "Read once the file is downloaded"
  },
  {
   "action": "assertValue",
   "label": "Camera",
   "text": "ILCE-7M4"
  },
  {
   "action": "assertExists",
   "label": "Photo"
  },
  {
   "action": "screenshot",
   "name": "03-downloaded"
  },
  {
   "action": "dump",
   "name": "03-downloaded"
