   "seconds": 3
  },
  {
   "action": "key",
   "text": "left"
  },
  {
   "action": "wait",
   "seconds": 2
  },
  {
   "action": "assertExists",
   "label": "3 of 8",
   "type": "staticText",
   "seconds": 3
  },
  {
   "action": "click",
   "label": "Done",
   "type": "button"
  },
  {
   "action": "wait",
   "seconds": 2
  },
  {
   "action": "assertMissing",
   "label": "Next Row",
   "type": "button"
  },
  {
   "action": "screenshot",
