  {
   "action": "waitFor",
   "label": "Remove from List",
   "type": "button",
   "seconds": 30
  },
  {
   "action": "key",
   "text": "escape"
  },
  {
   "action": "wait",
   "seconds": 2
  },
  {
   "action": "assertMissing",
